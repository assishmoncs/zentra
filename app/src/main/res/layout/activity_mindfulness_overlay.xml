<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="@dimen/space_3xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_4xl">

            <ImageView
                android:layout_width="@dimen/icon_large"
                android:layout_height="@dimen/icon_large"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="@string/mindfulness_logo_description"
                app:tint="@color/overlay_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xl"
                android:text="@string/mindfulness_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_display"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/mindfulness_default_app"
                android:textColor="@color/overlay_text_secondary"
                android:textSize="@dimen/text_body_large" />

            <TextView
                android:id="@+id/tvBreathTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3xl"
                android:contentDescription="@string/mindfulness_timer_initial"
                android:text="@string/mindfulness_timer_initial"
                android:textColor="@color/overlay_accent"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClose"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_4xl"
                android:enabled="false"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/mindfulness_continue"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body_large"
                app:cornerRadius="@dimen/button_radius"
                app:backgroundTint="@color/overlay_accent"
                android:textColor="@color/overlay_bg" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
