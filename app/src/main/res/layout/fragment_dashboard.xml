<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    android:clipToPadding="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Permission state -->
        <LinearLayout
            android:id="@+id/layoutPermission"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_4xl"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/space_3xl">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@mipmap/ic_launcher_foreground"
                        app:tint="@color/accent"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xl"
                        android:text="@string/permission_title"
                        android:textSize="@dimen/text_display"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/permission_description"
                        android:textSize="@dimen/text_body_large"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/permission_instruction"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_tertiary"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPermission"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/space_3xl"
                        android:text="@string/grant_access"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_body_large"
                        app:cornerRadius="@dimen/button_radius"
                        android:backgroundTint="@color/accent"
                        android:textColor="@color/bg_dark" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Main content -->
        <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2xl"
            android:paddingEnd="@dimen/space_2xl"
            android:paddingTop="@dimen/space_3xl"
            android:paddingBottom="@dimen/space_4xl"
            android:visibility="gone">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_today_label"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/app_title"
                android:textSize="@dimen/text_display"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_2xl"
                android:text="@string/dashboard_score_hint"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary" />

            <!-- Focus score -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardBackgroundColor="@color/bg_card"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="@dimen/space_3xl">

                    <TextView
                        android:id="@+id/tvScore"
                        style="@style/Zentra.Text.Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/score_placeholder"
                        android:textColor="@color/score_high" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/life_score_label"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_tertiary"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2xl"
                        android:text=""
                        android:textSize="@dimen/text_title"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_2xl"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/dashboard_goal_label"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_tertiary"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvGoalStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/goal_label"
                        android:textSize="@dimen/text_body_large"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Focus session -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardBackgroundColor="@color/bg_card"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/focus_session_title"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/text_tertiary"
                                android:letterSpacing="0.12"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:id="@+id/tvFocusTimer"
                                style="@style/Zentra.Text.Timer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/focus_session_timer_placeholder"
                                android:textColor="@color/text_primary" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFocusToggle"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/focus_session_start"
                            android:textAllCaps="false"
                            app:cornerRadius="@dimen/button_radius" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weekly summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardBackgroundColor="@color/bg_card"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider"
                android:layout_marginBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_week_summary"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_tertiary"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-black" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_weekly_score_label"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/text_tertiary" />

                            <TextView
                                android:id="@+id/tvWeeklyAvgScore"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/weekly_avg_score"
                                android:textSize="@dimen/text_body_large"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/space_lg"
                            android:layout_marginEnd="@dimen/space_lg"
                            android:background="@color/divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_weekly_time_label"
                                android:textSize="@dimen/text_caption"
                                android:textColor="@color/text_tertiary" />

                            <TextView
                                android:id="@+id/tvWeeklyTotalTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/weekly_total_time"
                                android:textSize="@dimen/text_body_large"
                                android:textColor="@color/text_primary"
                                android:fontFamily="sans-serif-medium" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Usage summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardBackgroundColor="@color/bg_card"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_usage_summary"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_tertiary"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/screen_time_today"
                        android:textSize="@dimen/text_title"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_lg"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/top_apps_today"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_tertiary"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tvApp1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/text_primary"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvApp2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/text_primary"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvApp3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/text_primary"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvNoApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_usage_data"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_tertiary"
                        android:paddingTop="@dimen/space_sm"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- State -->
            <TextView
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text=""
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_tertiary"
                android:gravity="center"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textSize="@dimen/text_body_large"
                app:cornerRadius="@dimen/button_radius"
                android:backgroundTint="@color/accent_soft"
                android:textColor="@color/accent"
                app:strokeColor="@color/accent"
                app:strokeWidth="1dp"
                android:visibility="gone" />

        </LinearLayout>
    </FrameLayout>
</ScrollView>
