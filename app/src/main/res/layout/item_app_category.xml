<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_xs"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/button_radius"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvAppName"
            style="@style/Zentra.Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCategory"
            android:minHeight="@dimen/min_touch_target"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_touch_target"
            android:text="Neutral"
            android:textSize="@dimen/text_caption"
            app:cornerRadius="@dimen/space_sm" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
